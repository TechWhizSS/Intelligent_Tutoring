# Export these variables before starting. No paid API key is used.
# Local CPU: run scripts/setup_free_music.py once.
FREE_MUSIC_DEVICE=CPU
FREE_MUSIC_THREADS=2
FREE_MUSIC_TIMEOUT=1800
# Optional official ACE-Step GPU API instead of local C++.
# Prefer the admin Connections page: upload song-service.env from our Colab notebook.
# These optional host variables override uploaded connection settings.
# LOCAL_MUSIC_URL=http://127.0.0.1:8001
# LOCAL_MUSIC_API_KEY=your-own-private-notebook-connection-key
PORT=8000
HOST=0.0.0.0
# Sample student login accepts any nonempty password. Admin uses this password.
ADMIN_SAP_ID=admin
ADMIN_PASSWORD=demo-admin
# Use 1 only behind HTTPS; demo mode must not protect real student records.
COOKIE_SECURE=0
