# Export these variables before starting. Never commit your real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LYRIA_MODEL=lyria-3.5
PORT=8000
HOST=0.0.0.0
# Sample student login accepts any nonempty password. Admin uses this password.
ADMIN_SAP_ID=admin
ADMIN_PASSWORD=demo-admin
# Use 1 only behind HTTPS; demo mode must not protect real student records.
COOKIE_SECURE=0
